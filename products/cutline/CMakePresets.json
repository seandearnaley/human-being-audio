{
    "version": 6,
    "include": [
        "../../cmake/native-presets.json"
    ],
    "configurePresets": [
        {
            "name": "engine",
            "displayName": "Core and engine",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CL_BUILD_PLUGIN": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "engine",
            "configurePreset": "engine"
        }
    ],
    "testPresets": [
        {
            "name": "engine",
            "configurePreset": "engine",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
