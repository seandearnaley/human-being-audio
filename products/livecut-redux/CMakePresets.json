{
    "version": 6,
    "include": [
        "../../cmake/native-presets.json"
    ],
    "configurePresets": [
        {
            "name": "engine",
            "displayName": "Engine and engine unit tests (no JUCE/Visage)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "LIVECUT_BUILD_PLUGIN": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "engine",
            "configurePreset": "engine"
        }
    ],
    "testPresets": [
        {
            "name": "engine",
            "configurePreset": "engine",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
