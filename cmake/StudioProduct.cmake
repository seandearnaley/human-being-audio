# Each product configures independently, including from an IDE.
function(hba_product slug)
    set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    set(catalog "${root}/studio.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${catalog}")
    file(READ "${catalog}" studio)
    foreach(key publisher website repository)
        string(JSON HBA_${key} GET "${studio}" ${key})
        set(HBA_${key} "${HBA_${key}}" PARENT_SCOPE)
    endforeach()
    foreach(key name bundle manufacturerCode pluginCode license)
        string(JSON HBA_${key} GET "${studio}" products "${slug}" ${key})
        set(HBA_${key} "${HBA_${key}}" PARENT_SCOPE)
    endforeach()
    configure_file("${root}/modules/studio-ui/Product.h.in" "studio/Product.h" @ONLY)
    juce_add_binary_data(hba_studio_art HEADER_NAME HbaStudioArt.h NAMESPACE HbaStudioArt
        SOURCES "${root}/design/studio/mark.png")
    add_library(hba_studio_ui INTERFACE)
    target_link_libraries(hba_studio_ui INTERFACE hba_studio_art)
    target_include_directories(hba_studio_ui INTERFACE "${root}/modules/studio-ui" "${CMAKE_CURRENT_BINARY_DIR}")
endfunction()
