{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/../../cmake/StudioQuality.cmake" }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Native development build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_OSX_ARCHITECTURES": "", "CMAKE_OSX_SYSROOT": "macosx" }
    },
    {
      "name": "rtsan",
      "displayName": "Ubuntu DSP with LLVM RealtimeSanitizer",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_FLAGS": "-fsanitize=realtime",
        "HBA_RTSAN": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" }
    }
  ],
  "buildPresets": [
    { "name": "lint", "configurePreset": "dev", "targets": ["studio-lint"] },
    { "name": "rtsan", "configurePreset": "rtsan", "targets": ["realtime-engine"] },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "rtsan", "configurePreset": "rtsan", "filter": { "include": { "label": "^realtime$" } },
      "execution": { "noTestsAction": "error" }, "output": { "outputOnFailure": true } },
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ],
  "workflowPresets": [
    {
      "name": "rtsan",
      "displayName": "Build and check the instrumented DSP",
      "steps": [
        { "type": "configure", "name": "rtsan" },
        { "type": "build", "name": "rtsan" },
        { "type": "test", "name": "rtsan" }
      ]
    },
    {
      "name": "check",
      "displayName": "Build and test this product",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    }
  ]
}
